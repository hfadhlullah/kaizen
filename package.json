{
  "name": "kaizen-agent",
  "version": "1.86.0",
  "description": "Staged workflow for AI agents — code, writing, research, operations: plan, human approval, build, independent review, bounded fix loop.",
  "type": "module",
  "bin": {
    "kaizen-agent": "./cli/install.ts",
    "kaizen": "./cli/install.ts"
  },
  "files": [
    "cli",
    "skills",
    "agents",
    "commands",
    "web",
    "assets/kaizen-logo.png",
    "assets/kaizen.ico",
    "README.md",
    "LICENSE",
    "!**/__pycache__",
    "!**/*.test.ts"
  ],
  "scripts": {
    "install-links": "bun run cli/install.ts",
    "check": "bun run cli/install.ts --check",
    "build:web": "bun run cli/build-web.ts",
    "dev": "bun cli/dev.ts",
    "audit:ui": "bun run cli/ui-audit.ts",
    "format": "prettier --write web/notebook web/term web/video web/ui web/components web/pages web/lib bot/web/app",
    "format:check": "prettier --check web/notebook web/term web/video web/ui web/components web/pages web/lib bot/web/app",
    "test": "bun test",
    "prepublishOnly": "bun test",
    "postpublish": "sh cli/release.sh",
    "publish:gh": "sh cli/publish-gh.sh",
    "release": "bun run cli/release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hfadhlullah/kaizen.git"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "agent",
    "workflow",
    "skill",
    "codex",
    "antigravity",
    "code-review",
    "writing",
    "research"
  ],
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/cli": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "prettier": "3.9.10",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zustand": "5.1.0"
  }
}
