{
  "name": "kaizen-agent",
  "version": "1.20.0",
  "description": "Staged workflow for AI agents — code, writing, research, operations: plan, human approval, build, independent review, bounded fix loop.",
  "type": "module",
  "bin": {
    "kaizen-agent": "./cli/install.ts",
    "kaizen": "./cli/install.ts"
  },
  "files": [
    "cli",
    "skills",
    "agents",
    "commands",
    "web",
    "assets/kaizen-logo.png",
    "assets/kaizen.ico",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install-links": "bun run cli/install.ts",
    "check": "bun run cli/install.ts --check",
    "build:web": "bun run cli/build-web.ts",
    "test": "bun test",
    "prepublishOnly": "bun test",
    "postpublish": "sh cli/release.sh",
    "publish:gh": "sh cli/publish-gh.sh",
    "release": "bun publish && bun run publish:gh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hfadhlullah/kaizen.git"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "agent",
    "workflow",
    "skill",
    "codex",
    "antigravity",
    "code-review",
    "writing",
    "research"
  ],
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5"
  }
}
