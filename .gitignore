node_modules/

# kaizen's run state. Unlike other projects, nothing under .kaizen/ is committed
# here: its spec*.md and config.yml are copies of skills/kaizen/, which is the
# source, and committing both is how the two drift apart.
.kaizen/
.npmrc

# Kaizen Bot: its API key and local database never leave this machine.
bot/.env
bot/data/
