# Which model provider powers every bot: anthropic | openai | requesty
PROVIDER=anthropic

# Model id for that provider. Optional for anthropic (defaults to claude-sonnet-5-5),
# required for openai (e.g. gpt-4.1) and requesty (e.g. anthropic/claude-sonnet-5-5).
MODEL=

# Only the key for the chosen PROVIDER is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REQUESTY_API_KEY=

# Port for the local page (default 7430).
PORT=7430

# The kaizen board Kaizen Bot works on (kaizen web). Loopback only. Can also be set in Settings.
BOARD_URL=http://127.0.0.1:7420
